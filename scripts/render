#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pillow", "fonttools", "catppuccin"]
# ///
"""Render ZMK keymap layers as .webp images (36-key split keyboard).

Disclosure: Throughout renderer and parser, I used probabilistic automation in the form of Anthropic Claude Sonnet 5.5 used via the Pi harness. I reviewed, edited, and approved all changes."""

from __future__ import annotations

import math
import re
import sys
from concurrent.futures import ProcessPoolExecutor
from functools import lru_cache
from dataclasses import dataclass, replace
from pathlib import Path

from catppuccin import PALETTE as catppuccin_palette
from fontTools.ttLib import TTFont
from PIL import Image, ImageDraw, ImageFont

from keymap_parser import Keymap, ParsedKey

ROOT = Path(__file__).resolve().parent.parent
OUT_DIR = ROOT / "images" / "layers"

# --- Palette (Catppuccin Mocha) ------------------------------------------------

PALETTE = catppuccin_palette.frappe.colors

BG_TINT = 0.15  # strength of the accent in subtle key backgrounds


def _blend(fg: str, bg: str, t: float) -> str:
    f, b = (tuple(int(c[i : i + 2], 16) for i in (1, 3, 5)) for c in (fg, bg))
    return "#" + "".join(f"{round(b[i] + (f[i] - b[i]) * t):02x}" for i in range(3))


# --- Geometry (in key units; 1.0 = key pitch) ---------------------------------

# Vertical stagger of each column, outer -> inner, for the left half.
COLUMN_OFFSETS = [0.40, 0.15, 0.0, 0.17, 0.30]
MIRROR_X = 6.24  # x of the axis between the two halves


@dataclass(frozen=True)
class Slot:
    x: float  # center
    y: float  # center
    w: float = 1.0
    h: float = 1.0
    rot: float = 0.0  # degrees, clockwise


def _left_slots() -> list[Slot]:
    slots = [
        Slot(col + 0.5, COLUMN_OFFSETS[col] + row + 0.5)
        for row in range(3)
        for col in range(5)
    ]
    # Thumbs, left -> right. The last one is the tall key.
    slots += [
        Slot(3.00, 3.95, rot=0),
        Slot(4.12, 4.05, rot=15),
        Slot(5.22, 4.25, h=1.5, rot=25),
    ]
    return slots


def _mirror(s: Slot) -> Slot:
    return Slot(2 * MIRROR_X - s.x, s.y, s.w, s.h, -s.rot)


def build_slots() -> list[Slot]:
    """36 slots in ZMK keymap order: for each of the 3 rows 5 left keys then
    5 right keys (left -> right), then 3 left thumbs, then 3 right thumbs."""
    left = _left_slots()
    left_main, left_thumbs = left[:15], left[15:]
    slots: list[Slot] = []
    for row in range(3):
        slots += left_main[row * 5 : row * 5 + 5]
        mirrored = [_mirror(s) for s in left_main[row * 5 : row * 5 + 5]]
        slots += sorted(mirrored, key=lambda s: s.x)
    slots += left_thumbs
    slots += sorted((_mirror(s) for s in left_thumbs), key=lambda s: s.x)
    return slots


SLOTS = build_slots()
assert len(SLOTS) == 36

# --- Keys & layers ------------------------------------------------------------


@dataclass(frozen=True)
class Key:
    label: str = ""
    hold: str = ""
    label_color: str = "text"
    hold_color: str = "overlay0"
    bg: str | None = None  # palette name; None -> default key color
    none: bool = False  # disabled key, drawn crossed out
    underline: tuple[int, ...] = ()  # indexes of label words to underline
    striped: bool = False  # diagonal stripes on the background (marks a difference)


# Hold labels (as produced by the parser) -> text and palette color.
HOLD_DISPLAY = {"apps_and_lcmd": "APPS", "greek_mode": "GREEK"}
# Layer node name -> palette color (used for hold labels and, in the layer's
# own render, the background of the key that activates it).
LAYER_COLORS = {
    "alpha_layer": "mauve",
    "greek_layer": "teal",
    "system_layer": "red",
    "bluetooth_layer": "blue",
    "apps_layer": "blue",
    "symbols_layer": "green",
    "numbers_layer": "yellow",
    "numpad_layer": "peach",
    "f1_f12_layer": "peach",
    "equal_operators_layer": "peach",
}

# Placeholder layers that are not worth rendering.
SKIP_LAYERS = {"trans_layer", "none_layer"}


def layer_filename(name: str) -> str:
    name = name.removesuffix("_layer")
    return {"default": "base"}.get(name, name)


# Key names -> symbols. Modifiers held together are joined without "+".
SYMBOLS = {
    "CMD": "⌘", "SHIFT": "⇧", "ALT": "⌥", "CTRL": "⌃", "HYPER": "✦",
    "BS": "⌫", "DEL": "⌦", "ENTER": "⏎", "TAB": "⇥", "ESC": "⎋",
    "CAPS": "⇪", "SPC": "␣",
}  # fmt: skip
# Characters that the main font lacks and are drawn with the symbol font.
# Symbol size relative to the label font.
SYMBOL_SCALE = 1.0


def symbolize(text: str) -> str:
    """Replace key names with symbols and drop "+" between combined keys,
    e.g. "CMD+SHIFT+4" -> "⌘⇧4". Words are kept (a lone "+" is the plus key)."""
    words = []
    for word in text.split():
        parts = re.split(r"\+(?=.)", word)
        words.append("".join(SYMBOLS.get(p, p) for p in parts))
    return " ".join(words)


GREEK = {
    "alpha": "α", "beta": "β", "gamma": "γ", "delta": "δ", "epsilon": "ε",
    "zeta": "ζ", "eta": "η", "theta": "θ", "iota": "ι", "kappa": "κ",
    "lambda": "λ", "mu": "μ", "nu": "ν", "xi": "ξ", "omikron": "ο",
    "omicron": "ο", "pi": "π", "rho": "ρ", "sigma": "σ", "tau": "τ",
    "upsilon": "υ", "phi": "φ", "chi": "χ", "psi": "ψ", "omega": "ω",
}  # fmt: skip
SYMBOL_CHARS = set("".join(SYMBOLS.values()) + "←↑→↓" + "".join(GREEK.values()))


def greekify(text: str) -> str:
    """Turn zmk-helpers unicode bindings ("&el_alpha") into Greek letters."""
    return re.sub(r"&el_(\w+)", lambda m: GREEK.get(m.group(1), m.group(0)), text)


def to_key(pk: ParsedKey, label_color: str = "text") -> Key:
    if pk.kind == "none":
        return Key(none=True)
    if pk.kind == "trans":
        return Key()
    underline: tuple[int, ...] = ()
    if pk.tap_mod and pk.tap_mod != pk.tap:
        label = f"{pk.tap} {pk.tap_mod}"
        if pk.mods == "ALT":  # underline the alt variant
            first = len(pk.tap.split())
            underline = tuple(range(first, first + len(pk.tap_mod.split())))
    else:
        label = pk.tap
    hold = symbolize(HOLD_DISPLAY.get(pk.hold, pk.hold))
    label = symbolize(greekify(label))
    return Key(label, hold, hold_color=LAYER_COLORS.get(pk.hold_layer, "overlay0"),
               label_color=label_color, underline=underline)


# --- Rendering ----------------------------------------------------------------

OUT_WIDTH = 1600  # px, width of every output image
UNIT = OUT_WIDTH / (2 * MIRROR_X + 2 * 0.5)  # px per key unit (layer images come out OUT_WIDTH wide)
GAP = 0.08  # gap between keys, in units
RADIUS = 0.12  # corner radius, in units (keys and whole image)
BORDER = 2  # px
MARGIN = 0.5  # units
SS = 2  # supersampling factor
STRIPE_TINT = 0.4  # strength of the yellow in stripes
STRIPE_WIDTH = 0.05  # units
STRIPE_PERIOD = 0.16  # units, distance between stripe starts (measured along an axis)

FONT_CANDIDATES = [
    "~/Library/Fonts/0xProto-Regular.otf",
    "/Library/Fonts/0xProto-Regular.otf",
    "~/.local/share/fonts/0xProto-Regular.otf",
    "/System/Library/Fonts/SFNSMono.ttf",
    "/System/Library/Fonts/Menlo.ttc",
    "/Library/Fonts/Arial.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
]


# Symbols come from San Francisco, the font macOS menus use, so they have
# natural sizes. Later fonts fill in glyphs SF lacks (e.g. ⇥ and ␣).
SYMBOL_FONT_CANDIDATES = [
    "/System/Library/Fonts/SFNS.ttf",
    "/System/Library/Fonts/Menlo.ttc",
    "/System/Library/Fonts/Apple Symbols.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
]


@lru_cache(maxsize=None)
def _cmap(path: str) -> frozenset[int]:
    try:
        return frozenset(TTFont(path, fontNumber=0).getBestCmap())
    except Exception:
        return frozenset()


@lru_cache(maxsize=None)
def load_font(size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    for path in FONT_CANDIDATES:
        try:
            return ImageFont.truetype(str(Path(path).expanduser()), size)
        except OSError:
            continue
    return ImageFont.load_default(size)


@lru_cache(maxsize=None)
def symbol_font(ch: str, size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    """First symbol font that has a glyph for `ch`."""
    for path in SYMBOL_FONT_CANDIDATES:
        if ord(ch) in _cmap(path):
            try:
                return ImageFont.truetype(path, size)
            except OSError:
                pass
    return load_font(size)


WORD_GAP = 0.3  # gap between words, in em (a regular space is ~0.6 em in mono fonts)


def runs(word: str, font) -> list[tuple[str, ImageFont.FreeTypeFont]]:
    """Split a word into runs, drawing symbol characters with the symbol font."""
    out: list[tuple[str, object]] = []
    for ch in word:
        if ch in SYMBOL_CHARS:
            f = symbol_font(ch, round(font.size * SYMBOL_SCALE))
        else:
            f = font
        if out and out[-1][1] is f:
            out[-1] = (out[-1][0] + ch, f)
        else:
            out.append((ch, f))
    return out


def word_width(d, word: str, font) -> float:
    return sum(d.textlength(t, font=f) for t, f in runs(word, font))


def text_width(d: ImageDraw.ImageDraw, text: str, font) -> float:
    words = text.split()
    gap = WORD_GAP * font.size
    return sum(word_width(d, w, font) for w in words) + gap * max(len(words) - 1, 0)


def draw_text(d, xy, text: str, font, fill, underline: tuple[int, ...] = ()) -> None:
    """Draw text centered at xy, with tighter spacing between words.
    Words whose index is in `underline` get underlined."""
    x = xy[0] - text_width(d, text, font) / 2
    ascent, descent = font.getmetrics()
    line_y = xy[1] + (ascent - descent) / 2 + 0.14 * font.size  # just below baseline
    for i, word in enumerate(text.split()):
        width = word_width(d, word, font)
        rx = x
        for t, f in runs(word, font):
            d.text((rx, xy[1]), t, font=f, fill=fill, anchor="lm")
            rx += d.textlength(t, font=f)
        if i in underline:
            d.line((x, line_y, x + width, line_y), fill=fill, width=max(2, round(font.size * 0.06)))
        x += width + WORD_GAP * font.size


def fit_font(d: ImageDraw.ImageDraw, text: str, max_width: float, size: int):
    """Largest font (<= size) for which the text fits max_width."""
    while size > 8:
        font = load_font(size)
        if text_width(d, text, font) <= max_width:
            return font
        size -= 2
    return load_font(size)


def color(name: str) -> str:
    """Hex for a Catppuccin color name; "bg_<name>" is a subtle tint of it."""
    if name.startswith("bg_"):
        return _blend(getattr(PALETTE, name[3:]).hex, PALETTE.base.hex, BG_TINT)
    return getattr(PALETTE, name).hex


def stripes(size: tuple[int, int], box: tuple[int, int, int, int], rot: float) -> Image.Image:
    """45° stripes (in the final image, so counter-rotated by the key's
    rotation) clipped to the rounded key rectangle `box`."""
    u = UNIT * SS
    n = 2 * max(size)
    layer = Image.new("RGBA", (n, n), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    period = STRIPE_PERIOD * u * math.sqrt(2)
    for k in range(-2 * n, 2 * n, max(1, round(period))):
        d.line((k, n, k + n, 0), fill=_blend(PALETTE.yellow.hex, PALETTE.base.hex, STRIPE_TINT), width=round(STRIPE_WIDTH * u * math.sqrt(2)))
    layer = layer.rotate(rot, resample=Image.BICUBIC)
    left, top = (n - size[0]) // 2, (n - size[1]) // 2
    layer = layer.crop((left, top, left + size[0], top + size[1]))
    mask = Image.new("L", size, 0)
    ImageDraw.Draw(mask).rounded_rectangle(box, radius=RADIUS * u, fill=255)
    layer.putalpha(Image.composite(layer.getchannel("A"), Image.new("L", size, 0), mask))
    return layer


def draw_key(canvas: Image.Image, slot: Slot, key: Key) -> None:
    u = UNIT * SS
    w = round((slot.w - GAP) * u)
    h = round((slot.h - GAP) * u)
    pad = 2 * SS
    tile = Image.new("RGBA", (w + 2 * pad, h + 2 * pad), (0, 0, 0, 0))
    d = ImageDraw.Draw(tile)
    d.rounded_rectangle(
        (pad, pad, pad + w - 1, pad + h - 1),
        radius=RADIUS * u,
        fill=color(key.bg or "base"),
        outline=color("surface1"),
        width=BORDER * SS,
    )

    if key.striped:
        tile.alpha_composite(stripes(tile.size, (pad, pad, pad + w - 1, pad + h - 1), slot.rot))
        d = ImageDraw.Draw(tile)
        d.rounded_rectangle(
            (pad, pad, pad + w - 1, pad + h - 1),
            radius=RADIUS * u,
            outline=color("surface1"),
            width=BORDER * SS,
        )

    cx, cy = tile.width / 2, tile.height / 2
    main_font = fit_font(d, key.label, (w - 0.2 * u), round(0.34 * u))
    hold_font = fit_font(d, key.hold, (w - 0.2 * u), round(0.15 * u))
    if key.label:
        ly = cy - (0.02 * u if key.hold else 0)
        draw_text(d, (cx, ly), key.label, main_font, color(key.label_color), key.underline)
    if key.hold:
        draw_text(d, (cx, pad + h - 0.17 * u), key.hold, hold_font, color(key.hold_color))

    if key.none:
        inset = 0.28 * u
        x0, y0, x1, y1 = pad + inset, pad + inset, pad + w - inset, pad + h - inset
        if h > w:  # keep the cross square on tall keys
            y0, y1 = cy - (x1 - x0) / 2, cy + (x1 - x0) / 2
        for line in ((x0, y0, x1, y1), (x0, y1, x1, y0)):
            d.line(line, fill=color("surface2"), width=3 * SS)

    if slot.rot:
        tile = tile.rotate(-slot.rot, resample=Image.BICUBIC, expand=True)
    canvas.alpha_composite(
        tile, (round(slot.x * u - tile.width / 2), round(slot.y * u - tile.height / 2))
    )


def round_corners(img: Image.Image) -> Image.Image:
    """Make the image corners transparent, using the same radius as the keys."""
    mask = Image.new("L", img.size, 0)
    ImageDraw.Draw(mask).rounded_rectangle((0, 0, img.width - 1, img.height - 1), radius=RADIUS * UNIT * SS, fill=255)
    img = img.copy()
    img.putalpha(mask)
    return img


def render_layer(name: str, keys: list[Key]) -> Path:
    if len(keys) != len(SLOTS):
        raise ValueError(f"layer {name!r}: expected {len(SLOTS)} keys, got {len(keys)}")
    u = UNIT * SS
    width = (2 * MIRROR_X + 2 * MARGIN) * u
    height = (max(s.y + s.h / 2 + abs(math.sin(math.radians(s.rot))) * 0.5 for s in SLOTS) + 2 * MARGIN) * u
    canvas = Image.new("RGBA", (round(width), round(height)), color("crust"))
    # Shift everything by the margin.
    layer = Image.new("RGBA", canvas.size, (0, 0, 0, 0))
    for slot, key in zip(SLOTS, keys):
        draw_key(layer, Slot(slot.x + MARGIN, slot.y + MARGIN, slot.w, slot.h, slot.rot), key)
    canvas.alpha_composite(layer)
    canvas = round_corners(canvas)
    out = canvas.resize((canvas.width // SS, canvas.height // SS), Image.LANCZOS)
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    path = OUT_DIR / f"{name}.webp"
    out.save(path, "WEBP", quality=90, method=6)
    return path


# (layer, key index, title, description) -- real keys from the keymap.
LEGEND_ROWS = [
    ("default_layer", 0, "Tap / hold", "Big label is the tap.\nSmall label at the bottom is the hold."),
    ("default_layer", 27, "Shift tap", "Right label is what you get with ⇧ held."),
    ("default_layer", 24, "Alt tap", "Underlined right label is what you get with ⌥ held."),
    ("default_layer", 30, "Layer color", "Hold label is colored like the layer it activates."),
    ("system_layer", 32, "Layer activator", "Tinted key is the one you hold to reach this layer."),
    ("alpha_layer", 9, "Transparent", "Empty key falls through to the layer below."),
    ("apps_layer", 9, "Disabled", "Crossed out key does nothing."),
    ("polemak", 23, "Striped", "Different than in Colemak DH."),
]


# Colemak DH letters (30 alpha keys, row by row) that Polemak is compared against.
COLEMAK_DH = "QWFPBJLUY;ARSTGMNEIOZXCDVKH,./"


def polemak_keys(km: Keymap) -> list[Key]:
    """The alpha layer with non-letter keys transparent and keys that differ
    from Colemak DH striped."""
    keys = []
    for i, pk in enumerate(km.layer("alpha_layer")):
        if not pk.kind and len(pk.tap) == 1 and pk.tap.isalpha() and i < len(COLEMAK_DH):
            keys.append(Key(pk.tap, label_color=LAYER_COLORS["alpha_layer"], striped=pk.tap != COLEMAK_DH[i]))
        else:
            keys.append(Key())
    return keys


def layer_key(km: Keymap, layer: str, i: int) -> Key:
    if layer == "polemak":
        return polemak_keys(km)[i]
    key = to_key(km.layer(layer)[i], LAYER_COLORS.get(layer, "text"))
    if layer in LAYER_COLORS and km.activating_key(layer) == i:
        key = replace(key, bg="bg_" + LAYER_COLORS[layer])
    return key


def render_legend(km: Keymap) -> Path:
    u = UNIT * SS
    row_h = 1.25 * u
    key_x = MARGIN * u
    title_font = load_font(round(0.2 * u))
    body_font = load_font(round(0.15 * u))
    probe = ImageDraw.Draw(Image.new("RGB", (1, 1)))
    text_w = max(text_width(probe, line, body_font)
                 for *_, d in LEGEND_ROWS for line in d.split("\n"))
    cols = 2
    per_col = math.ceil(len(LEGEND_ROWS) / cols)
    col_w = 1.6 * u + text_w + 0.6 * u  # key + text + gutter
    width = round(2 * MARGIN * u + cols * col_w - 0.6 * u)
    height = round(2 * MARGIN * u + row_h * per_col)
    canvas = Image.new("RGBA", (width, height), color("crust"))
    layer = Image.new("RGBA", canvas.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    for i, (lname, idx, title, desc) in enumerate(LEGEND_ROWS):
        key = layer_key(km, lname, idx)
        col, row = divmod(i, per_col)  # fill column by column
        cy = MARGIN * u + row_h * (row + 0.5)
        kx = key_x + col * col_w
        tx = kx + 1.6 * u
        draw_key(layer, Slot((kx + 0.5 * u) / u, cy / u), key)
        lines = desc.split("\n")
        shift = -0.1 * (len(lines) - 1)
        rows = [(title, title_font, -0.17 + shift, "text")]
        rows += [(ln, body_font, 0.17 + shift + 0.2 * j, "overlay0") for j, ln in enumerate(lines)]
        for text, font, dy, fill in rows:
            draw_text(d, (tx + text_width(d, text, font) / 2, cy + dy * u), text, font, color(fill))
    canvas.alpha_composite(layer)
    canvas = round_corners(canvas)
    out = canvas.resize((OUT_WIDTH, round(height * OUT_WIDTH / width)), Image.LANCZOS)
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    path = OUT_DIR / "legend.webp"
    out.save(path, "WEBP", quality=90, method=6)
    return path


def main() -> None:
    km = Keymap()
    if sys.argv[1:] == ["legend"]:
        print(render_legend(km))
        return
    names = sys.argv[1:] or [n for n in km.layers if n not in SKIP_LAYERS] + ["polemak"]
    jobs: list[tuple[str, list[Key]]] = []
    for name in names:
        if name == "polemak":
            jobs.append((name, polemak_keys(km)))
            continue
        label_color = LAYER_COLORS.get(name, "text")  # default layer stays neutral
        keys = [to_key(pk, label_color) for pk in km.layer(name)]
        # Tint the key that is held to bring this layer up.
        if name in LAYER_COLORS and (i := km.activating_key(name)) is not None:
            bg = "bg_" + LAYER_COLORS[name]
            keys[i] = replace(keys[i], bg=bg)
        jobs.append((layer_filename(name), keys))
    # Layers are CPU-bound, so render them in parallel processes.
    with ProcessPoolExecutor() as pool:
        futures = [pool.submit(render_layer, n, k) for n, k in jobs]
        legend = render_legend(km) if not sys.argv[1:] else None
        for f in futures:
            print(f.result())
    if legend:
        print(legend)


if __name__ == "__main__":
    main()
